# ============================================================
# 環境變數範例
# 複製此檔為 .env.local 後填入自己的值
#
# 部署到 Cloudflare Workers 時「不需要任何環境變數」，
# 因為前端與即時連線（/ws）同一個網域。
# ============================================================

# 即時通訊模式：
#   auto       = 自動判斷（預設）：本機→mock、部署後→cloudflare
#   mock       = 強制本機 mock（同一個瀏覽器的多個分頁互通）
#   cloudflare = 強制使用自己的 Cloudflare Worker
#   supabase   = 強制使用 Supabase（舊版備援）
VITE_REALTIME_MODE=auto

# ---- Cloudflare（選填）--------------------------------------
# 留空 = 用目前網址（部署後即為同一個 Worker，不需要設定）。
# 本機想連 `wrangler dev`（預設 8787 埠）時才需要填。
VITE_REALTIME_URL=

# ---- Supabase（選填，舊版備援）------------------------------
# 兩者都留空即可。若仍想使用 Supabase，填了就會優先採用。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- 對外網址（選填）----------------------------------------
# 有填的話，老師端產生的 QR Code 會固定用這個網址；
# 沒填則使用瀏覽器目前開啟的網址。
VITE_PUBLIC_URL=
