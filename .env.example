# ============================================================
# 環境變數範例
# 複製此檔為 .env.local 後填入自己的值
# ============================================================

# 即時通訊模式：
#   auto     = 有填 Supabase 就用 Supabase，否則用本機 mock（預設）
#   mock     = 強制使用本機 mock（同一個瀏覽器的多個分頁互通）
#   supabase = 強制使用 Supabase
VITE_REALTIME_MODE=auto

# ---- Supabase（選填）----------------------------------------
# 沒有填這兩個值時，遊戲會自動以 mock 模式運行（方便開發）。
# 取得方式見 README.md「啟用雲端即時連線」。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- 對外網址（選填）----------------------------------------
# 部署後的公開網址，例如 https://pixel-heroes.vercel.app
# 有填的話，老師端產生的 QR Code 會固定用這個網址；
# 沒填則使用瀏覽器目前開啟的網址（部署到 Vercel 時通常不用填）。
VITE_PUBLIC_URL=
